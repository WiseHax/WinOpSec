# Runtime state snapshots & registry backups (contain machine identifiers)
backups/*
!backups/.gitkeep

# Loose state/registry exports if ever written outside backups/
state_*.json
*.reg.bak
*.bak
*.tmp

# PowerShell & terminal histories
*.history
ConsoleHost_history.txt
*.log

# Operating system artifacts
Thumbs.db
Desktop.ini
.DS_Store

# Editor artifacts
.vscode/
.idea/
*.swp
